# Пример конфигурации. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# Файл .env в git не попадает.

# Django
DJANGO_SECRET_KEY=change-me-generate-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (используется и compose, и приложением)
POSTGRES_DB=budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget

# Для запуска без Docker/Podman (venv) хост - localhost.
# При запуске в compose переменная переопределяется на хост db (см. docker-compose.yml).
DATABASE_URL=postgres://budget:budget@localhost:5432/budget

# Продакшен: DJANGO_DEBUG=False, реальные хосты и домен;
# при публикации через Caddy добавьте, например:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://budget.example.com
